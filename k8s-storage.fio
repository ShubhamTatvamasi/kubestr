[global]
ioengine=libaio
direct=1
runtime=60
time_based=1
ramp_time=5
group_reporting=1
randrepeat=0
verify=0
gtod_reduce=1
size=2G

# Sequential write throughput
[seq-write]
rw=write
bs=1M
iodepth=16
numjobs=1

# Sequential read throughput
[seq-read]
rw=read
bs=1M
iodepth=16
numjobs=1
stonewall=1

# Random write IOPS/latency
[rand-write]
rw=randwrite
bs=4k
iodepth=32
numjobs=4
stonewall=1

# Random read IOPS/latency
[rand-read]
rw=randread
bs=4k
iodepth=32
numjobs=4
stonewall=1

# Mixed random read/write (70/30), simulates typical DB workload
[rand-rw-mix]
rw=randrw
rwmixread=70
bs=4k
iodepth=32
numjobs=4
stonewall=1
